<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OpenApiDiagnosticsProject Condition="'$(OpenApiDiagnosticsProject)' == ''">../../../soenneker.openapi.diagnostics/src/Soenneker.OpenApi.Diagnostics/Soenneker.OpenApi.Diagnostics.csproj</OpenApiDiagnosticsProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Soenneker.OpenApi.Fixer/Soenneker.OpenApi.Fixer.csproj" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="11.0.0-rc.3.26522.148" />
    <ProjectReference Include="$(OpenApiDiagnosticsProject)" />
  </ItemGroup>
</Project>
